; ColorRush Godot simulation/render project
config_version=5

[application]
config/name="ColorRushStudio"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.svg"

[display]
window/stretch/mode="aspect"
window/size/viewport_width=1080
window/size/viewport_height=1920
window/startup_focus=true

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=9.8
common/physics_jitter_fix=true

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
shadows/directional_shadow/size=2048
textures/default_filters/anisotropic_filtering_level=4

[audio]
buses/default_bus_layout=""
